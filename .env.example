# Coolify Environment katalog. NE committati prave vrijednosti.
# Zalijepi ključeve u Coolify UI. Frontend: VITE_API_BASE_URL i kao Build Argument.
#
# Convention:
#   this file              = Coolify / compose catalog (all services)
#   backend/.env.example   = local NestJS + Prisma + worker (copy to backend/.env)
#   frontend/.env.example  = local Vite (copy to frontend/.env)
#
# Auth JWT, SMTP, Entra/AD, and install-wizard rerun are not env keys.
# JWT lives in Settings registry (private.auth.jwtSigningSecret).
# Redis: no REDIS_URL duplicate. Prisma: only DATABASE_URL (PostgreSQL).

# --- App / Coolify public URLs (FQDN contract; API_PUBLIC_URL is the Vite build-arg source) ---
NODE_ENV=production
APP_PUBLIC_URL=https://desk.ba101.top
API_PUBLIC_URL=https://api.desk.ba101.top
# HTTP + Socket.IO CORS. CSV: desk origin [, chrome-extension://<id>]. Unset => origin false (never *).
CORS_ORIGIN=https://desk.ba101.top

# --- API (backend container; PORT default 10001) ---
# Install wizard unlock (review S4): min 16 chars, e.g. `openssl rand -hex 24`.
# Without it the wizard is closed; unused after installation completes.
INSTALL_TOKEN=
# Behind Coolify/Traefik: trust one proxy hop so rate limits see the client IP.
TRUST_PROXY=1
# Hard upload limit in MB (1-100, default 25); the admin setting is clamped to it (review S7).
ATTACHMENT_UPLOAD_MAX_MB=25
# Optional antivirus (review N5): clamd INSTREAM. Unset = no scan. Fails closed unless CLAMAV_FAIL_OPEN=true.
# The compose file ships a `clamav` service: set CLAMAV_HOST=clamav to enable.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_FAIL_OPEN=false
PORT=10001
# Docker image default; volume mounts here. Optional for local (see backend/.env.example).
UPLOAD_ROOT=/usr/app/uploads

# --- PostgreSQL (required). Coolify Database resource; not in compose. ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ephelpdesk

# --- Redis / BullMQ (backend + worker; host required) ---
# Pair must match ACL user in ops/redis-acl.line (not Coolify Redis "default" user).
REDIS_HOST=redis-core
# Optional; default 6379
REDIS_PORT=6379
# ACL username; empty is ignored. Default in compose: ephelpdesk
REDIS_USERNAME=ephelpdesk
# Same secret as the live ACL password for user ephelpdesk on redis-core.
# `change-me` is a docs placeholder only — Coolify must use the real ACL password
# (currently the same as redis-global REDIS_ADMIN_PASSWORD), otherwise WRONGPASS.
REDIS_PASSWORD=change-me
# Optional; default ephelpdesk (ioredis adds trailing :)
REDIS_KEY_PREFIX=ephelpdesk
# Optional; default bull:ephelpdesk (BullMQ prefix)
QUEUE_PREFIX=bull:ephelpdesk

# --- Frontend image build (required for Vite bake; keep equal to API_PUBLIC_URL) ---
VITE_API_BASE_URL=https://api.desk.ba101.top
