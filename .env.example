# Coolify Environment katalog. NE committati prave vrijednosti.
# Zalijepi ključeve u Coolify UI. Frontend: VITE_API_BASE_URL i kao Build Argument.
#
# Convention:
#   this file              = Coolify / compose catalog (all services)
#   backend/.env.example   = local NestJS + Prisma + worker (copy to backend/.env)
#   frontend/.env.example  = local Vite (copy to frontend/.env)
#
# Auth JWT, SMTP, Entra/AD, and install-wizard rerun are not env keys.
# JWT lives in Settings registry (private.auth.jwtSigningSecret).
# Redis: no REDIS_URL duplicate. Prisma: only DATABASE_URL (PostgreSQL).

# --- App / Coolify public URLs (FQDN contract; API_PUBLIC_URL is the Vite build-arg source) ---
NODE_ENV=production
# Also the base for links/buttons in e-mails (paket 1.5); without it e-mails go out without links.
APP_PUBLIC_URL=https://desk.ba101.top
# Paket 1.8: putanja do PEM CA certifikata za LDAPS (prazno = sistemsko povjerenje).
AD_LDAPS_CA_CERT_PATH=
# Alternativa bez file mounta: PEM kodiran u base64 (base64 -w0 ca.pem). PATH ima prednost.
AD_LDAPS_CA_CERT_BASE64=
API_PUBLIC_URL=https://api.desk.ba101.top
# HTTP + Socket.IO CORS. CSV: desk origin [, chrome-extension://<id>]. Unset => origin false (never *).
CORS_ORIGIN=https://desk.ba101.top

# --- API (backend container; PORT default 10001) ---
# Install wizard unlock (review S4): min 16 chars, e.g. `openssl rand -hex 24`.
# Without it the wizard is closed; unused after installation completes.
INSTALL_TOKEN=
# Paket 2.1: AES-256-GCM ključ za TOTP tajne — base64 od tačno 32 bajta
# (`openssl rand -base64 32`). Obavezan za MFA; čuvati u backupu tajni —
# gubitak ili promjena ključa znači ponovno postavljanje MFA za sve (CLI reset-mfa).
MFA_ENCRYPTION_KEY=
# Paket 2.3: reply-by-e-mail token secret (>=16 chars). Empty = derived from MFA_ENCRYPTION_KEY.
INBOUND_EMAIL_TOKEN_SECRET=
# Paket 2.6: anonymization tombstone HMAC key (>=16 chars). Empty = derived from MFA_ENCRYPTION_KEY.
PRIVACY_TOMBSTONE_KEY=
# Paket 2.6: export encryption master key (>=16 chars). Empty = derived from MFA_ENCRYPTION_KEY.
# Changing it makes READY exports unreadable (they expire within 7 days anyway).
PRIVACY_EXPORT_KEY=
# Paket 2.7: fallback alarm channel, used only when Postgres or Redis is down.
# smtp[s]://user:pass@host:port; recipients comma-separated. Empty = log only.
OPS_ALERT_SMTP_URL=
OPS_ALERT_EMAIL_TO=
OPS_ALERT_EMAIL_FROM=
OPS_ALERT_TEAMS_WEBHOOK_URL=
# Paket 2.7: Uptime Kuma push URL (the worker pings it after every completed health check, once a minute).
OPS_UPTIME_PUSH_URL=
# Behind Coolify/Traefik: trust one proxy hop so rate limits see the client IP.
TRUST_PROXY=1
# Hard upload limit in MB (1-100, default 25); the admin setting is clamped to it (review S7).
ATTACHMENT_UPLOAD_MAX_MB=25
# Optional antivirus (review N5): clamd INSTREAM. Unset = no scan. Fails closed unless CLAMAV_FAIL_OPEN=true.
# The compose file ships a `clamav` service: set CLAMAV_HOST=clamav to enable.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_FAIL_OPEN=false
PORT=10001
# Docker image default; volume mounts here. Optional for local (see backend/.env.example).
UPLOAD_ROOT=/usr/app/uploads

# --- PostgreSQL (required). Coolify Database resource; not in compose. ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/servicedesk

# --- Redis / BullMQ (backend + worker; host required) ---
# Pair must match ACL user in ops/redis-acl.line (not Coolify Redis "default" user).
REDIS_HOST=redis-core
# Optional; default 6379
REDIS_PORT=6379
# ACL username; empty is ignored. Default in compose: servicedesk
REDIS_USERNAME=servicedesk
# Same secret as the live ACL password for user servicedesk on redis-core.
# `change-me` is a docs placeholder only — Coolify must use the real ACL password
# (currently the same as redis-global REDIS_ADMIN_PASSWORD), otherwise WRONGPASS.
REDIS_PASSWORD=change-me
# Optional; default servicedesk (ioredis adds trailing :)
REDIS_KEY_PREFIX=servicedesk
# Optional; default bull:servicedesk (BullMQ prefix)
QUEUE_PREFIX=bull:servicedesk

# --- Frontend image build (required for Vite bake; keep equal to API_PUBLIC_URL) ---
VITE_API_BASE_URL=https://api.desk.ba101.top

# Paket 5.4.0-a (M1): WebAuthn/passkey drugi faktor. RP ID se izvodi iz domene
# prvog CORS_ORIGIN origin-a; navodi se samo ako API živi na poddomeni frontend
# origin-a (npr. api.example uz frontend na example.com -> WEBAUTHN_RP_ID=example).
# WEBAUTHN_RP_ID=
# Dodatni expected origin-i (npr. staging host), zarezom odvojeni; default je
# prvi CORS_ORIGIN origin.
# WEBAUTHN_EXPECTED_ORIGIN=
# Naziv aplikacije koji autentikator prikazuje pri WebAuthn ceremoniji
# (default: Service Desk).
# APP_NAME=

# Paket 3.1: Teams connector simulator (min. 32 characters). Without it simulator mode is unavailable.
TEAMS_SIMULATOR_SECRET=
# Paket 3.1: public API origin; the Teams messaging endpoint is <API_PUBLIC_URL>/integrations/teams/messages
# (falls back to APP_PUBLIC_URL when the API is served from the same origin).
API_PUBLIC_URL=

# --- Optional: key rotation (previous keys, read-only during rotation) ---
# MFA_ENCRYPTION_KEY_PREVIOUS=
# INBOUND_EMAIL_TOKEN_SECRET_PREVIOUS=
# PRIVACY_TOMBSTONE_KEY_PREVIOUS=
# Signs exported configuration packages; at least 32 characters to count as set.
# CONFIG_PACKAGE_SIGNING_KEY=

# --- Optional: install wizard SMTP prefill (wizard only; runtime SMTP lives in settings) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=service-desk@example.com
# SMTP_TLS=true

# --- Optional: database pool / query metrics ---
# DB_POOL_MAX=40
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=3000
# DB_STATEMENT_TIMEOUT_MS=5000
# Set to `worker` by the worker service in compose (smaller pool, longer statement budget).
# DATABASE_POOL_ROLE=
# DB_QUERY_METRICS=true
# DB_QUERY_BUDGET=
# DB_QUERY_BUDGET_WARN=

# --- Optional: caches, retention, runtime toggles ---
# REPORT_DASHBOARD_CACHE_TTL_SECONDS=60
# REPORT_SUMMARY_CACHE_TTL_SECONDS=
# SETTINGS_SNAPSHOT_TTL_MS=5000
# NOTIFICATION_RETENTION_DAYS=
# OPS_WATCHDOG_DISABLED=false
# WS_GROUP_FEED_LEGACY_FULL_EMIT=on

# --- Optional: temporary-password delivery guard ---
# Addresses on these (comma-separated) domains NEVER receive the temporary
# password by email — the response always carries it (UI delivery). Default:
# example.com (RFC 2606), so E2E accounts stay test-mail-free on SMTP stacks.
# RESERVED_NO_EMAIL_DOMAINS=example.com

# --- Optional: build metadata (Coolify sets SOURCE_COMMIT automatically) ---
# APP_VERSION=
# SOURCE_COMMIT=
