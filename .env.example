# Coolify Environment katalog. NE committati prave vrijednosti.
# Zalijepi ključeve u Coolify UI. Frontend: VITE_API_BASE_URL i kao Build Argument.

# --- App ---
NODE_ENV=production
TZ=Europe/Sarajevo
APP_PUBLIC_URL=https://desk.ba101.top
API_PUBLIC_URL=https://api.desk.ba101.top
CORS_ORIGIN=https://desk.ba101.top
INSTALL_ALLOW_RERUN=false

# --- API ---
PORT=10001
UPLOAD_ROOT=/usr/app/uploads

# --- PostgreSQL (Coolify Database resource) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ephelpdesk

# --- Redis (kontejner redis-core, mreža redis-net) ---
REDIS_HOST=redis-core
REDIS_PORT=6379
REDIS_USERNAME=ephelpdesk
REDIS_PASSWORD=change-me
REDIS_KEY_PREFIX=ephelpdesk
QUEUE_PREFIX=bull:ephelpdesk

# --- Auth (install wizard može prepisati mode; JWT secret obavezan) ---
JWT_SIGNING_SECRET=change-me-min-32-chars

# --- Frontend build (Vite bake) ---
VITE_API_BASE_URL=https://api.desk.ba101.top

# --- SMTP (opciono; wizard može dopuniti) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Entra / AD (opciono dok wizard ne uključi entra_ad) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
AD_LDAPS_URLS=
AD_BIND_DN=
AD_BIND_PASSWORD=
