+function setup() {
+  const harness = createTicketsServiceHarness();
+  const { memory } = harness;
+  const seed = (
+    n: number,
+    overrides: Parameters<typeof buildTicketRecord>[0] extends infer T
+      ? Partial<T>
+      : never,
