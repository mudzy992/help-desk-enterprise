/// Paket 2.7 (§5.1): an operational alarm. At most one open (non-RESOLVED) row
/// per key (partial unique index in the migration). Details hold numbers only,
/// never personal data. Resolved rows are purged after
/// `private.ops.alerts.historyDays`.
model OpsAlert {
  id                   String    @id @default(cuid())
  key                  String    @db.VarChar(64)
  /// WARNING | CRITICAL
  severity             String    @db.VarChar(10)
  /// FIRING | ACKNOWLEDGED | RESOLVED
  status               String    @db.VarChar(14)
  details              Json      @default("{}")
  firstSeenAt          DateTime
  lastSeenAt           DateTime
  resolvedAt           DateTime?
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  lastNotifiedAt       DateTime?
  notifyCount          Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([resolvedAt])
  @@index([key, firstSeenAt])
}

/// Paket 2.7 (§8.2): an incident shown on the status page. While open, every
/// linked service shows the worst impact of its open incidents; the manual
/// `Service.availability` is the baseline and is never overwritten.
model ServiceIncident {
  problems ProblemIncident[]
  id              String                        @id @default(cuid())
  title           String                        @db.VarChar(200)
  titleEn         String?                       @db.VarChar(200)
  /// DEGRADED | DOWN | MAINTENANCE
  impact          String                        @db.VarChar(12)
  /// INVESTIGATING | IDENTIFIED | MONITORING | RESOLVED
  status          String                        @db.VarChar(14)
  /// ALL_USERS | STAFF_ONLY
  visibility      String                        @default("ALL_USERS") @db.VarChar(12)
  startedAt       DateTime
  resolvedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  services        ServiceIncidentService[]
  updates         ServiceIncidentUpdate[]
  subscriptions   ServiceIncidentSubscription[]
  tickets         TicketIncidentLink[]

  @@index([status])
  @@index([resolvedAt])
  @@index([startedAt])
}

model ServiceIncidentService {
  incidentId String
  serviceId  String
  incident   ServiceIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([incidentId, serviceId])
  @@index([serviceId])
}

model ServiceIncidentUpdate {
  id           String          @id @default(cuid())
  incidentId   String
  status       String          @db.VarChar(14)
  message      String          @db.VarChar(4000)
  authorUserId String?
  createdAt    DateTime        @default(now())
  incident     ServiceIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

/// A user asked to be told when the incident is resolved.
model ServiceIncidentSubscription {
  incidentId String
  userId     String
  createdAt  DateTime        @default(now())
  notifiedAt DateTime?
  incident   ServiceIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([incidentId, userId])
  @@index([userId])
}

/// A ticket reported under a known incident (§8.3).
model TicketIncidentLink {
  ticketId       String
  incidentId     String
  linkedByUserId String?
  createdAt      DateTime        @default(now())
  ticket         Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  incident       ServiceIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@id([ticketId, incidentId])
  @@index([incidentId])
}
