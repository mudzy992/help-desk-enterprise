model BusinessHoursCalendar {
  id           String            @id @default(cuid())
  key          String            @unique
  name         String
  timezone     String
  weeklyHours  Json
  isActive     Boolean           @default(true)
  holidays     CalendarHoliday[]
  slaProfiles  SlaProfile[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model CalendarHoliday {
  id         String                 @id @default(cuid())
  calendarId String
  date       DateTime               @db.Date
  name       String
  calendar   BusinessHoursCalendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
}

model SlaProfile {
  id          String                 @id @default(cuid())
  key         String                 @unique
  name        String
  description String?
  calendarId  String
  isActive    Boolean                @default(true)
  calendar    BusinessHoursCalendar  @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  rules       SlaRule[]
  escalations SlaEscalationRule[]
  services    Service[]
  policyPacks PolicyPack[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([calendarId])
  @@index([isActive])
}

model SlaRule {
  id                   String              @id @default(cuid())
  slaProfileId         String
  priority             TicketPriority
  responseMinutes      Int
  resolutionMinutes    Int
  evaluationOrder      Int                 @default(100)
  organizationalUnitId String?
  serviceId            String?
  slaProfile           SlaProfile          @relation(fields: [slaProfileId], references: [id], onDelete: Cascade)
  organizationalUnit   OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id], onDelete: Cascade)
  service              Service?            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([slaProfileId, priority])
  @@index([slaProfileId, evaluationOrder])
  @@index([organizationalUnitId])
  @@index([serviceId])
}

model TicketSlaState {
  id                      String    @id @default(cuid())
  ticketId                String    @unique
  slaProfileId            String?
  slaRuleId               String?
  responseMinutes         Int       @default(0)
  resolutionMinutes       Int       @default(0)
  startedAt               DateTime
  responseDueAt           DateTime?
  resolutionDueAt         DateTime?
  respondedAt             DateTime?
  resolutionCompletedAt   DateTime?
  pausedAt                DateTime?
  pausedBusinessMinutes   Int       @default(0)
  isResponseBreached      Boolean   @default(false)
  isResolutionBreached    Boolean   @default(false)
  firedEscalationKeys     String[]  @default([])
  ticket                  Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  updatedAt               DateTime  @updatedAt

  @@index([pausedAt])
  @@index([responseDueAt])
  @@index([resolutionDueAt])
}

model SlaEscalationRule {
  id                   String   @id @default(cuid())
  slaProfileId         String
  triggerOffsetMinutes Int
  targetGroupId        String?
  targetRole           String?
  targetUserId         String?
  slaProfile           SlaProfile @relation(fields: [slaProfileId], references: [id], onDelete: Cascade)
  targetGroup          Group?     @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  targetUser           User?      @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([slaProfileId])
  @@index([targetGroupId])
  @@index([targetUserId])
}
