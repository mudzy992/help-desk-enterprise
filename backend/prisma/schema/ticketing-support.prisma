/// Package 1.3: where a time entry came from.
enum TimeLogSource {
  TIMER
  MANUAL
}

/// Package 1.3: why a timer segment ended (null while it runs).
enum TimeLogStopReason {
  MANUAL
  AUTO_IDLE
  AUTO_MAX_DURATION
  AUTO_TICKET_CLOSED
  AUTO_SWITCHED
}

model TicketTimeLog {
  id                String             @id @default(cuid())
  ticketId          String
  userId            String
  startedAt         DateTime
  endedAt           DateTime?
  durationSeconds   Int?
  /// Package 1.3 (T2)
  source            TimeLogSource      @default(TIMER)
  stopReason        TimeLogStopReason?
  lastHeartbeatAt   DateTime?
  note              String?
  correctedAt       DateTime?
  correctedByUserId String?
  correctionReason  String?
  deletedAt         DateTime?
  deletedByUserId   String?
  deleteReason      String?
  ticket            Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([userId, ticketId])
  @@index([userId, endedAt])
  @@index([endedAt, startedAt])
}

model TicketAttachment {
  id               String             @id @default(cuid())
  ticketId         String
  messageId        String?
  storagePath      String             @unique
  originalName     String
  mimeType         String
  extension        String
  sizeBytes        Int
  classification   DataClassification
  uploadedByUserId String
  ticket           Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message          TicketMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy       User               @relation("TicketAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([ticketId])
  @@index([messageId])
  @@index([uploadedByUserId])
}

model TicketApproval {
  id             String         @id @default(cuid())
  ticketId       String
  stepOrder      Int            @default(1)
  status         ApprovalStatus @default(PENDING)
  approverUserId String?
  comment        String?
  decidedAt      DateTime?
  ticket         Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  approver       User?          @relation(fields: [approverUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([ticketId])
  @@index([approverUserId])
}

model CloseCode {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  serviceId String?
  isActive  Boolean  @default(true)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedView {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  sort      Json?
  columns   Json?
  isDefault Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model TicketCsat {
  id                 String   @id @default(cuid())
  ticketId           String   @unique
  rating             Int
  comment            String?
  submittedByUserId  String
  ticket             Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  submittedBy        User     @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
}

model TicketConfidentialGrant {
  id               String   @id @default(cuid())
  ticketId         String
  userId           String?
  groupId          String?
  grantedByUserId  String
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user             User?    @relation("ConfidentialGrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  group            Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  grantedBy        User     @relation("ConfidentialGrantActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([groupId])
}

model BreakGlassEvent {
  id          String    @id @default(cuid())
  ticketId    String
  actorUserId String
  reason      String
  expiresAt   DateTime?
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor       User      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([ticketId])
  @@index([actorUserId])
}

model GuardrailClaim {
  id          String    @id @default(cuid())
  kind        String
  subjectKey  String
  fingerprint String
  ticketId    String?
  actorUserId String?
  ticket      Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  claimedAt   DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([kind, subjectKey, fingerprint])
  @@index([kind, subjectKey, claimedAt])
  @@index([ticketId])
  @@index([expiresAt])
}
