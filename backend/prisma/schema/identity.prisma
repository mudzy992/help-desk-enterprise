model User {
  id                   String                     @id @default(cuid())
  email                String                     @unique
  displayName          String
  /// Paket 1.5: UI and e-mail language (bs, en). Null → private.i18n.defaultLocale.
  preferredLocale      String?                    @db.VarChar(8)
  /// SuperAdmin identities must always be true. External providers cannot bind here.
  isLocalOnly          Boolean                    @default(false)
  isActive             Boolean                    @default(true)
  /// bcrypt hash for local credentials. Never log or return this value.
  localPasswordHash    String?
  /// When true, local login must complete password change before a session is issued.
  mustChangePassword   Boolean                    @default(false)
  /// Paket 2.1: last local password change (expiry policy). Null = unknown.
  passwordChangedAt    DateTime?
  /// Phase 2.2: bumped whenever this user's roles, groups, unit or active flag
  /// change. It is part of the authorization cache key (`authz:{id}:v{n}`), so a
  /// bump makes every cached decision unreachable at once.
  authzVersion         Int                        @default(0)
  /// Directory object id for linked users. Must remain null for SuperAdmin.
  entraObjectId        String?                    @unique
  /// Paket 1.8: on-premises AD objectGUID (LDAPS sync). Not the Entra `oid`.
  directoryObjectGuid  String?                    @unique
  /// Paket 1.8: set when the directory sync deactivated the user (disabled in
  /// AD or gone from scope). Only such users are reactivated by a later sync;
  /// an admin deactivation is never undone automatically.
  directoryDeactivatedAt DateTime?
  directorySyncedAt    DateTime?
  distinguishedName    String?
  company              String?
  department           String?
  organizationalUnitId String?
  managerUserId        String?
  organizationalUnit   OrganizationalUnit?        @relation(fields: [organizationalUnitId], references: [id], onDelete: Restrict)
  manager              User?                      @relation("UserManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  directReports        User[]                     @relation("UserManager")
  userRoles            UserRole[]
  groupMembers         GroupMember[]
  requestedTickets     Ticket[]                   @relation("TicketRequester")
  assignedTickets      Ticket[]                   @relation("TicketAssignee")
  ticketParticipants   TicketParticipant[]
  authoredMessages     TicketMessage[]
  ticketActivities     TicketActivity[]
  timeLogs             TicketTimeLog[]
  responseTemplates    ResponseTemplate[] @relation("ResponseTemplateOwner")
  playbookStepChecks   TicketPlaybookStep[] @relation("TicketPlaybookStepCheckedBy")
  uploadedAttachments  TicketAttachment[]         @relation("TicketAttachmentUploader")
  approvals            TicketApproval[]
  savedViews           SavedView[]
  csatSubmissions      TicketCsat[]
  confidentialGrants   TicketConfidentialGrant[]  @relation("ConfidentialGrantSubject")
  grantedConfidential  TicketConfidentialGrant[]  @relation("ConfidentialGrantActor")
  breakGlassEvents     BreakGlassEvent[]
  guardrailClaims      GuardrailClaim[]
  ownedArticles        KnowledgeArticle[]         @relation("KnowledgeArticleOwner")
  reviewedArticles     KnowledgeArticle[]         @relation("KnowledgeArticleReviewer")
  knowledgeFeedbacks   KnowledgeFeedback[]
  knowledgeInterceptResolutions KnowledgeInterceptResolution[]
  notifications                   Notification[]
  notificationReceipts            NotificationReceipt[]
  notificationEmailDeliveries     NotificationEmailDelivery[]
  auditLogs                       AuditLog[]
  changeLogs           ChangeLog[]
  mfa                  UserMfa?
  mfaRecoveryCodes     UserMfaRecoveryCode[]
  sessions             UserSession[]         @relation("UserSessionOwner")
  revokedSessions      UserSession[]         @relation("UserSessionRevokedBy")
  passwordHistory      UserPasswordHistory[]
  configVersions       ConfigVersion[]
  slaEscalationTargets SlaEscalationRule[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([organizationalUnitId])
  @@index([managerUserId])
}

model Role {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  isSystem        Boolean          @default(false)
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id                   String              @id @default(cuid())
  userId               String
  roleId               String
  organizationalUnitId String?
  serviceId            String?
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                 Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationalUnit   OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id], onDelete: Cascade)
  service              Service?            @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([organizationalUnitId])
  @@index([serviceId])
}

model Group {
  id                   String                 @id @default(cuid())
  name                 String
  key                  String                 @unique
  organizationalUnitId String
  isFallback           Boolean                @default(false)
  /// Overrides the service's and the global auto-assign strategy for tickets
  /// this group handles. NONE defers to the service, then the global setting
  /// (see resolveEffectiveAutoAssignStrategy). Decision D2.
  autoAssignStrategy   AutoAssignStrategy     @default(NONE)
  organizationalUnit   OrganizationalUnit     @relation(fields: [organizationalUnitId], references: [id], onDelete: Restrict)
  members              GroupMember[]
  notifications        Notification[]
  assignedTickets      Ticket[]               @relation("TicketAssignedGroup")
  participants         TicketParticipant[]
  routingRules         RoutingRule[]
  ownedArticles        KnowledgeArticle[]
  escalationRules      SlaEscalationRule[]
  confidentialGrants   TicketConfidentialGrant[]
  responseTemplates    ResponseTemplateGroup[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([organizationalUnitId])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
}

model PolicyPack {
  id                     String               @id @default(cuid())
  key                    String               @unique
  name                   String
  description            String?
  defaultClassification  DataClassification   @default(INTERNAL)
  requiresApproval       Boolean              @default(false)
  slaProfileId           String?
  slaProfile             SlaProfile?          @relation(fields: [slaProfileId], references: [id], onDelete: SetNull)
  organizationalUnits    OrganizationalUnit[]
  services               Service[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}
