/// Paket 1.8: history of directory operations (test connection, dry-run,
/// apply, scheduled sync). `summary` holds counts only; `plan` holds the
/// dry-run change list (no secrets, no passwords) and is pruned after 30 days.
model DirectorySyncRun {
  id          String                 @id @default(cuid())
  kind        DirectorySyncRunKind
  status      DirectorySyncRunStatus
  source      String                 @db.VarChar(32)
  actorUserId String?
  startedAt   DateTime               @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  summary     Json?
  plan        Json?
  errorCode   String?                @db.VarChar(64)
  /// DRY_RUN only: the APPLY run that executed this plan (applied once).
  appliedByRunId String?             @unique

  @@index([startedAt(sort: Desc)])
}

enum DirectorySyncRunKind {
  TEST_CONNECTION
  DRY_RUN
  APPLY
  SCHEDULED
}

enum DirectorySyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  ABORTED_SAFEGUARD
}
