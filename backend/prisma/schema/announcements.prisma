/// Paket 2.9 (K2): announcements with an optional read acknowledgement.
/// Stored status is DRAFT | PUBLISHED | WITHDRAWN; SCHEDULED and ENDED are
/// derived from startsAt/endsAt (never stale, no job needed to flip them).
enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AnnouncementDisplayMode {
  BANNER
  MODAL
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

model Announcement {
  id                           String                        @id @default(cuid())
  title                        String                        @db.VarChar(120)
  /// Markdown subset (same renderer as the privacy notice), never HTML.
  body                         String                        @db.VarChar(4000)
  severity                     AnnouncementSeverity          @default(INFO)
  displayMode                  AnnouncementDisplayMode       @default(BANNER)
  requiresAcknowledgement      Boolean                       @default(false)
  /// In-app notification to the audience when the announcement starts.
  notifyAudience               Boolean                       @default(false)
  startsAt                     DateTime
  endsAt                       DateTime
  /// Empty array = no filter. A user is in the audience when every non-empty filter matches.
  audienceRoles                String[]                      @default([])
  /// Includes every sub-unit (ouPath prefix).
  audienceOrganizationalUnitIds String[]                     @default([])
  audienceGroupIds             String[]                      @default([])
  serviceId                    String?
  status                       AnnouncementStatus            @default(DRAFT)
  /// Bumped on every edit of a published announcement (previous text in AnnouncementRevision).
  version                      Int                           @default(1)
  createdById                  String?
  publishedById                String?
  publishedAt                  DateTime?
  withdrawnAt                  DateTime?
  /// Audience size captured at publication ("X of Y" in the report).
  audienceSizeAtPublish        Int?
  /// Acknowledgements removed by anonymization (the report keeps counting them).
  anonymizedAcknowledgements   Int                           @default(0)
  audienceNotifiedAt           DateTime?
  lastReminderAt               DateTime?
  /// K2b: also e-mail the audience (only together with notifyAudience).
  sendEmail                    Boolean                       @default(false)
  /// K2b: post an Adaptive Card to the Teams channel when it starts (Teams must be enabled).
  postToTeams                  Boolean                       @default(false)
  teamsPostedAt                DateTime?
  /// Last Teams result: SENT | FAILED | SKIPPED_DISABLED (null = not attempted).
  teamsResult                  String?                       @db.VarChar(24)
  createdBy                    User?                         @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy                  User?                         @relation("AnnouncementPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  service                      Service?                      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  acknowledgements             AnnouncementAcknowledgement[]
  dismissals                   AnnouncementDismissal[]
  revisions                    AnnouncementRevision[]
  emailRuns                    AnnouncementEmailRun[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@index([status, endsAt])
  @@index([startsAt])
  @@index([serviceId])
}

model AnnouncementAcknowledgement {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  acknowledgedAt DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation("AnnouncementAcknowledgementUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

/// A banner without acknowledgement that the user closed; it is not shown again.
model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  dismissedAt    DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation("AnnouncementDismissalUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

/// Text of a published announcement before an edit (§3.3 "verzija se čuva").
model AnnouncementRevision {
  id             String       @id @default(cuid())
  announcementId String
  version        Int
  title          String       @db.VarChar(120)
  body           String       @db.VarChar(4000)
  editedById     String?
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, version])
}

enum AnnouncementEmailKind {
  PUBLISHED
  REMINDER
}

/// K2b: one e-mail pass over the audience (start or reminder). The worker walks
/// the audience in user-id order in batches; `cursor` is the last user handled,
/// so a restart continues where it stopped and the delivery ledger
/// (NotificationEmailDelivery, dedupe per run) keeps it exactly-once.
model AnnouncementEmailRun {
  id             String                @id @default(cuid())
  announcementId String
  kind           AnnouncementEmailKind
  cursor         String?
  sentCount      Int                   @default(0)
  skippedCount   Int                   @default(0)
  failedCount    Int                   @default(0)
  /// Why the run ended early (EMAIL_CHANNEL_DISABLED, NOT_ACTIVE) or null.
  endReason      String?               @db.VarChar(40)
  createdAt      DateTime              @default(now())
  completedAt    DateTime?
  announcement   Announcement          @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([completedAt, createdAt])
  @@index([announcementId])
}
