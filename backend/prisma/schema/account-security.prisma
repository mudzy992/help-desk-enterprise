/// Paket 2.1 (M1): TOTP second factor of a local account. The secret is
/// AES-256-GCM encrypted with MFA_ENCRYPTION_KEY; never returned or logged.
model UserMfa {
  userId                 String    @id
  secretEncrypted        String?
  enabledAt              DateTime?
  /// Last accepted TOTP time step — a code is never accepted twice (replay).
  lastUsedStep           BigInt?
  lastUsedAt             DateTime?
  /// Enrollment in progress (expires after 15 min).
  pendingSecretEncrypted String?
  pendingCreatedAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Paket 5.2.1 (M2 #4): single-use recovery codes, stored as keyed HMAC only.
model UserMfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  /// Non-secret fingerprint identifies which active/previous MFA key can verify the HMAC.
  keyId     String    @db.VarChar(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, keyId, usedAt])
}

/// Paket 5.4.0-a (M1): phishing-resistant second factor. One row per registered
/// passkey/WebAuthn credential. The public key is the COSE key as returned by
/// `@simplewebauthn` (base64url); the credential id is base64url and unique.
/// `counter` guards against cloned authenticators (must be monotonic);
/// `lastUsedIp` is stored raw like `UserSession.ipAddress` (admin-visible).
model UserPasskeyCredential {
  id                String    @id @default(cuid())
  userId            String
  credentialId      String    @db.VarChar(512)
  publicKey         String    @db.VarChar(1024)
  counter           BigInt    @default(0)
  transports        String?
  aaguid            String?   @db.VarChar(36)
  deviceName        String?   @db.VarChar(120)
  isBackupEligible  Boolean   @default(false)
  isBackedUp        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?
  lastUsedIp        String?   @db.VarChar(64)
  user              User      @relation("UserPasskeyCredentialOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([credentialId])
  @@index([userId])
}

/// Paket 2.1 (M6): one row per sign-in; the id is the `sid` claim and stays
/// the same across token refreshes.
model UserSession {
  id              String    @id @default(cuid())
  userId          String
  provider        String    @db.VarChar(16)
  mfaMethod       String?   @db.VarChar(16)
  ipAddress       String?   @db.VarChar(64)
  userAgent       String?   @db.VarChar(512)
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedReason   String?   @db.VarChar(32)
  revokedByUserId String?
  user            User      @relation("UserSessionOwner", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy       User?     @relation("UserSessionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

/// Paket 2.1 (M7): bcrypt hashes of previous local passwords (reuse check).
model UserPasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
