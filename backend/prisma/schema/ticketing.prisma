model Ticket {
  id                   String                     @id @default(cuid())
  ticketNumber         String                     @unique
  title                String
  description          String
  status               TicketStatus               @default(PENDING)
  priority             TicketPriority
  impact               TicketImpact
  urgency              TicketUrgency
  classification       DataClassification         @default(INTERNAL)
  isConfidential       Boolean                    @default(false)
  formData             Json?
  originUnitId         String
  serviceId            String
  /// Persisted formVersionRef. Historical tickets resolve this exact FormVersion.id and never the current/latest form.
  formVersionId        String
  requesterId          String
  assignedGroupId      String?
  assignedUserId       String?
  parentTicketId       String?
  mergedIntoTicketId   String?
  reopenedFromTicketId String?
  closeCodeId          String?
  resolutionNote       String?
  dueAt                DateTime?
  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  archivedAt           DateTime?
  waitingForUserEnteredAt      DateTime?
  waitingForUserReminderSentAt DateTime?
  /// Package 1.6: denormalised from TicketForwardEvent (group-to-group forwards only),
  /// so the list indicator and the "forwarded" filter cost no extra query.
  forwardCount             Int       @default(0)
  lastForwardedAt          DateTime?
  lastForwardFromGroupName String?
  originUnit           OrganizationalUnit         @relation("TicketOriginUnit", fields: [originUnitId], references: [id], onDelete: Restrict)
  service              Service                    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  formVersion          FormVersion                @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  requester            User                       @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedGroup        Group?                     @relation("TicketAssignedGroup", fields: [assignedGroupId], references: [id], onDelete: SetNull)
  assignedUser         User?                      @relation("TicketAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  parentTicket         Ticket?                    @relation("TicketSplit", fields: [parentTicketId], references: [id], onDelete: SetNull)
  childTickets         Ticket[]                   @relation("TicketSplit")
  mergedInto           Ticket?                    @relation("TicketMerge", fields: [mergedIntoTicketId], references: [id], onDelete: SetNull)
  mergedTickets        Ticket[]                   @relation("TicketMerge")
  reopenedFrom         Ticket?                    @relation("TicketReopen", fields: [reopenedFromTicketId], references: [id], onDelete: SetNull)
  reopenedTickets      Ticket[]                   @relation("TicketReopen")
  closeCode            CloseCode?                 @relation(fields: [closeCodeId], references: [id], onDelete: SetNull)
  participants         TicketParticipant[]
  messages             TicketMessage[]
  activities           TicketActivity[]
  timeLogs             TicketTimeLog[]
  attachments          TicketAttachment[]
  approvals            TicketApproval[]
  csat                 TicketCsat?
  confidentialGrants   TicketConfidentialGrant[]
  breakGlassEvents     BreakGlassEvent[]
  guardrailClaims      GuardrailClaim[]
  slaState             TicketSlaState?
  notifications        Notification[]
  forwardEvents        TicketForwardEvent[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([status])
  @@index([originUnitId])
  @@index([serviceId])
  @@index([assignedUserId])
  @@index([assignedGroupId])
  @@index([priority])
  @@index([requesterId])
  @@index([isConfidential])
  @@index([formVersionId])
  @@index([parentTicketId])
  @@index([mergedIntoTicketId])
  // Self-FK (onDelete: SetNull): without it every deleted ticket scans the table.
  @@index([reopenedFromTicketId])
  @@index([status, waitingForUserEnteredAt])
  @@index([status, closedAt])
  @@index([archivedAt])
  /// Phase 1.1 (plan §1.1): list reads filter by one of these columns and order
  /// by createdAt DESC, so the compound index serves both filter and ordering.
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([assignedUserId, createdAt(sort: Desc)])
  @@index([assignedGroupId, createdAt(sort: Desc)])
  @@index([requesterId, createdAt(sort: Desc)])
  @@index([originUnitId, createdAt(sort: Desc)])
  /// Phase 1.2 (plan §1.2): the search matches with a leading-wildcard ILIKE,
  /// which only a trigram GIN index can serve. Both columns are searched
  /// separately, so each one gets its own index. The `pg_trgm` extension is
  /// created by migration `20260923140000_search_trigram_indexes`.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Ticket_title_trgm_idx")
  @@index([ticketNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Ticket_ticketNumber_trgm_idx")
}

model TicketParticipant {
  id        String          @id @default(cuid())
  ticketId  String
  role      ParticipantRole
  userId    String?
  groupId   String?
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  group     Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([ticketId])
  @@index([ticketId, role])
  @@index([userId])
  @@index([groupId])
}

model TicketMessage {
  id           String            @id @default(cuid())
  ticketId     String
  type         MessageType
  body         String
  authorUserId String?
  ticket       Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?             @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  attachments  TicketAttachment[]
  createdAt    DateTime          @default(now())

  @@index([ticketId])
  @@index([ticketId, type])
  @@index([ticketId, createdAt])
  @@index([authorUserId])
}

model TicketActivity {
  id          String   @id @default(cuid())
  ticketId    String
  action      String
  payload     Json?
  actorUserId String?
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([actorUserId])
}

/// Package 1.1: one row per forward (manual, bulk or "return to previous group").
/// Group/unit/user ids are plain strings on purpose: the history must survive a
/// deleted group or user, so names are snapshotted too.
model TicketForwardEvent {
  id                  String   @id @default(cuid())
  ticketId            String
  fromGroupId         String?
  fromGroupName       String?
  fromUnitId          String?
  toGroupId           String
  toGroupName         String
  toUnitId            String
  toUserId            String?
  previousAssigneeId  String?
  actorUserId         String?
  reason              String
  isCrossOu           Boolean
  requesterNotified   Boolean  @default(false)
  viaBulk             Boolean  @default(false)
  ticket              Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([toUnitId, createdAt])
  @@index([toGroupId, createdAt])
}
