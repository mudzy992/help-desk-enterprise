model Ticket {
  id                   String                     @id @default(cuid())
  ticketNumber         String                     @unique
  title                String
  description          String
  status               TicketStatus               @default(PENDING)
  priority             TicketPriority
  impact               TicketImpact
  urgency              TicketUrgency
  classification       DataClassification         @default(INTERNAL)
  isConfidential       Boolean                    @default(false)
  formData             Json?
  originUnitId         String
  serviceId            String
  formVersionId        String
  requesterId          String
  assignedGroupId      String?
  assignedUserId       String?
  parentTicketId       String?
  mergedIntoTicketId   String?
  reopenedFromTicketId String?
  closeCodeId          String?
  resolutionNote       String?
  dueAt                DateTime?
  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  archivedAt           DateTime?
  originUnit           OrganizationalUnit         @relation("TicketOriginUnit", fields: [originUnitId], references: [id], onDelete: Restrict)
  service              Service                    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  formVersion          FormVersion                @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  requester            User                       @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedGroup        Group?                     @relation("TicketAssignedGroup", fields: [assignedGroupId], references: [id], onDelete: SetNull)
  assignedUser         User?                      @relation("TicketAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  parentTicket         Ticket?                    @relation("TicketSplit", fields: [parentTicketId], references: [id], onDelete: SetNull)
  childTickets         Ticket[]                   @relation("TicketSplit")
  mergedInto           Ticket?                    @relation("TicketMerge", fields: [mergedIntoTicketId], references: [id], onDelete: SetNull)
  mergedTickets        Ticket[]                   @relation("TicketMerge")
  reopenedFrom         Ticket?                    @relation("TicketReopen", fields: [reopenedFromTicketId], references: [id], onDelete: SetNull)
  reopenedTickets      Ticket[]                   @relation("TicketReopen")
  closeCode            CloseCode?                 @relation(fields: [closeCodeId], references: [id], onDelete: SetNull)
  participants         TicketParticipant[]
  messages             TicketMessage[]
  activities           TicketActivity[]
  timeLogs             TicketTimeLog[]
  attachments          TicketAttachment[]
  approvals            TicketApproval[]
  csat                 TicketCsat?
  confidentialGrants   TicketConfidentialGrant[]
  breakGlassEvents     BreakGlassEvent[]
  slaState             TicketSlaState?
  notifications        Notification[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([status])
  @@index([originUnitId])
  @@index([serviceId])
  @@index([assignedUserId])
  @@index([assignedGroupId])
  @@index([priority])
  @@index([requesterId])
  @@index([isConfidential])
}

model TicketParticipant {
  id        String          @id @default(cuid())
  ticketId  String
  role      ParticipantRole
  userId    String?
  groupId   String?
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  group     Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([groupId])
}

model TicketMessage {
  id           String            @id @default(cuid())
  ticketId     String
  type         MessageType
  body         String
  authorUserId String?
  ticket       Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?             @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  attachments  TicketAttachment[]
  createdAt    DateTime          @default(now())

  @@index([ticketId])
  @@index([authorUserId])
}

model TicketActivity {
  id          String   @id @default(cuid())
  ticketId    String
  action      String
  payload     Json?
  actorUserId String?
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([actorUserId])
}
