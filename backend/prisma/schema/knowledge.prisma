model KnowledgeArticle {
  id                   String                  @id @default(cuid())
  slug                 String                  @unique
  title                String
  body                 String
  status               KnowledgeArticleStatus  @default(DRAFT)
  classification       DataClassification      @default(INTERNAL)
  isStale              Boolean                 @default(false)
  reviewDueAt          DateTime?
  publishedAt          DateTime?
  lastReviewedAt       DateTime?
  archivedAt           DateTime?
  ownerUserId          String?
  ownerGroupId         String?
  reviewerUserId       String?
  serviceId            String
  organizationalUnitId String
  searchVector         Unsupported("tsvector")?
  ownerUser            User?                   @relation("KnowledgeArticleOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerGroup           Group?                  @relation(fields: [ownerGroupId], references: [id], onDelete: SetNull)
  reviewerUser         User?                   @relation("KnowledgeArticleReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  service              Service                 @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  organizationalUnit   OrganizationalUnit      @relation(fields: [organizationalUnitId], references: [id], onDelete: Restrict)
  feedbacks            KnowledgeFeedback[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([ownerUserId])
  @@index([reviewerUserId])
  @@index([serviceId])
  @@index([organizationalUnitId])
  @@index([status])
  @@index([classification])
  @@index([searchVector], type: Gin)
}

model KnowledgeFeedback {
  id        String           @id @default(cuid())
  articleId String
  userId    String
  isHelpful Boolean
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([articleId, userId])
  @@index([articleId])
  @@index([userId])
}
