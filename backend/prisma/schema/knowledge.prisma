model KnowledgeArticle {
  id                   String              @id @default(cuid())
  slug                 String              @unique
  title                String
  body                 String
  isPublished          Boolean             @default(false)
  isStale              Boolean             @default(false)
  reviewDueAt          DateTime?
  ownerUserId          String?
  ownerGroupId         String?
  serviceId            String?
  organizationalUnitId String?
  searchVector         Unsupported("tsvector")?
  ownerUser            User?               @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerGroup           Group?              @relation(fields: [ownerGroupId], references: [id], onDelete: SetNull)
  service              Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  organizationalUnit   OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id], onDelete: SetNull)
  feedbacks            KnowledgeFeedback[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([ownerUserId])
  @@index([serviceId])
  @@index([organizationalUnitId])
  @@index([searchVector], type: Gin)
}

model KnowledgeFeedback {
  id        String           @id @default(cuid())
  articleId String
  userId    String
  isHelpful Boolean
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([articleId, userId])
}
