model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  ticketId  String?
  payload   Json?
  dedupeKey String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([ticketId])
}

model NotificationEmailDelivery {
  id          String   @id @default(cuid())
  userId      String
  dedupeKey   String
  toAddress   String
  templateKey String
  status      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, dedupeKey])
  @@index([status])
}

model AuditLog {
  id                     String              @id @default(cuid())
  action                 String
  entityType             String
  entityId               String
  metadata               Json?
  requestId              String?
  previousHash           String?
  hash                   String
  actorUserId            String?
  organizationalUnitId   String?
  actor                  User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organizationalUnit     OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([organizationalUnitId])
  @@index([createdAt])
}

model IntegrationJob {
  id          String                @id @default(cuid())
  type        IntegrationJobType
  status      IntegrationJobStatus  @default(PENDING)
  payload     Json
  lastError   String?
  attempts    Int                   @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, nextRetryAt])
  @@index([type])
}

model ConfigVersion {
  id              String              @id @default(cuid())
  version         Int                 @unique
  status          ConfigVersionStatus @default(DRAFT)
  snapshot        Json
  releaseNotes    String?
  createdByUserId String?
  activatedAt     DateTime?
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
}

model AppSetting {
  id          String       @id @default(cuid())
  key         String       @unique
  value       Json
  scope       SettingScope
  isSecret    Boolean      @default(false)
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
