model Notification {
  id              String                @id @default(cuid())
  /// Personal notification: the recipient. `null` for a group notification.
  userId          String?
  /// Option A (2026-09-24): one row per group event instead of one row per member.
  /// Visible to members whose membership existed when the row was created, minus
  /// `excludedUserIds`; read state lives in `NotificationReceipt`.
  groupId         String?
  excludedUserIds String[]              @default([])
  type            String
  title           String
  body            String?
  isRead          Boolean               @default(false)
  readAt          DateTime?
  ticketId        String?
  payload         Json?
  dedupeKey       String
  user            User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  group           Group?                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ticket          Ticket?               @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  receipts        NotificationReceipt[]
  createdAt       DateTime              @default(now())

  @@unique([userId, dedupeKey])
  @@unique([groupId, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([groupId, createdAt])
  @@index([ticketId])
}

/// Per-user read mark of a group notification (Option A "seen-mark").
model NotificationReceipt {
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
}

model NotificationEmailDelivery {
  id          String   @id @default(cuid())
  userId      String
  dedupeKey   String
  toAddress   String
  templateKey String
  status      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, dedupeKey])
  @@index([status])
}

/// Paket 2.2 (N3): one row only where the user differs from the default of a
/// catalogue category (`null` column = "as default").
model UserNotificationPreference {
  userId    String
  category  String   @db.VarChar(64)
  inApp     Boolean?
  /// IMMEDIATE | DIGEST | OFF
  email     String?  @db.VarChar(16)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@index([category, inApp])
}

/// Paket 2.2 (N5/N6): quiet hours and digest time, minutes after local midnight
/// in the installation time zone.
model UserNotificationSchedule {
  userId             String    @id
  quietHoursEnabled  Boolean   @default(false)
  quietStartMinute   Int       @default(1080)
  quietEndMinute     Int       @default(420)
  quietWeekends      Boolean   @default(false)
  /// null = administrator default
  digestMinute       Int?
  digestWorkdaysOnly Boolean   @default(true)
  lastDigestSentAt   DateTime?
  lastQuietFlushAt   DateTime?
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Paket 2.2: an e-mail held back for the daily digest (DIGEST) or until quiet
/// hours end (QUIET). No message body is stored.
model NotificationDigestItem {
  id        String   @id @default(cuid())
  userId    String
  category  String   @db.VarChar(64)
  type      String   @db.VarChar(64)
  /// DIGEST | QUIET
  reason    String   @db.VarChar(8)
  ticketId  String?
  event     String   @db.VarChar(64)
  dedupeKey String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id                     String              @id @default(cuid())
  action                 String
  entityType             String
  entityId               String
  metadata               Json?
  requestId              String?
  previousHash           String?
  hash                   String
  actorUserId            String?
  organizationalUnitId   String?
  actor                  User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organizationalUnit     OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([organizationalUnitId])
  @@index([createdAt])
}

model IntegrationJob {
  id          String                @id @default(cuid())
  type        IntegrationJobType
  status      IntegrationJobStatus  @default(PENDING)
  payload     Json
  lastError   String?
  attempts    Int                   @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, nextRetryAt])
  @@index([type])
}

model ConfigVersion {
  id              String              @id @default(cuid())
  version         Int                 @unique
  status          ConfigVersionStatus @default(DRAFT)
  snapshot        Json
  releaseNotes    String?
  createdByUserId String?
  activatedAt     DateTime?
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
}

model AppSetting {
  id          String       @id @default(cuid())
  key         String       @unique
  value       Json
  scope       SettingScope
  isSecret    Boolean      @default(false)
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
