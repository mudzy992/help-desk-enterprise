model Notification {
  id              String                @id @default(cuid())
  /// Personal notification: the recipient. `null` for a group notification.
  userId          String?
  /// Option A (2026-09-24): one row per group event instead of one row per member.
  /// Visible to members whose membership existed when the row was created, minus
  /// `excludedUserIds`; read state lives in `NotificationReceipt`.
  groupId         String?
  excludedUserIds String[]              @default([])
  type            String
  title           String
  body            String?
  isRead          Boolean               @default(false)
  readAt          DateTime?
  ticketId        String?
  payload         Json?
  dedupeKey       String
  user            User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  group           Group?                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ticket          Ticket?               @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  receipts        NotificationReceipt[]
  createdAt       DateTime              @default(now())

  @@unique([userId, dedupeKey])
  @@unique([groupId, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([groupId, createdAt])
  @@index([ticketId])
}

/// Per-user read mark of a group notification (Option A "seen-mark").
model NotificationReceipt {
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
}

model NotificationEmailDelivery {
  id          String   @id @default(cuid())
  userId      String
  dedupeKey   String
  toAddress   String
  templateKey String
  status      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, dedupeKey])
  @@index([status])
  @@index([createdAt])
}

/// Paket 2.2 (N3): one row only where the user differs from the default of a
/// catalogue category (`null` column = "as default").
model UserNotificationPreference {
  userId    String
  category  String   @db.VarChar(64)
  inApp     Boolean?
  /// IMMEDIATE | DIGEST | OFF
  email     String?  @db.VarChar(16)
  /// Paket 3.1: Teams channel; null = category default (see teams-preference-defaults.ts).
  teams     Boolean?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@index([category, inApp])
}

/// Paket 2.2 (N5/N6): quiet hours and digest time, minutes after local midnight
/// in the installation time zone.
model UserNotificationSchedule {
  userId             String    @id
  quietHoursEnabled  Boolean   @default(false)
  quietStartMinute   Int       @default(1080)
  quietEndMinute     Int       @default(420)
  quietWeekends      Boolean   @default(false)
  /// null = administrator default
  digestMinute       Int?
  digestWorkdaysOnly Boolean   @default(true)
  lastDigestSentAt   DateTime?
  lastQuietFlushAt   DateTime?
  /// Paket 2.2a: slot of the last weekly ticket report sent.
  lastWeeklyReportAt DateTime?
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Paket 2.2: an e-mail held back for the daily digest (DIGEST) or until quiet
/// hours end (QUIET). No message body is stored.
model NotificationDigestItem {
  id        String   @id @default(cuid())
  userId    String
  category  String   @db.VarChar(64)
  type      String   @db.VarChar(64)
  /// DIGEST | QUIET
  reason    String   @db.VarChar(8)
  ticketId  String?
  event     String   @db.VarChar(64)
  dedupeKey String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id                     String              @id @default(cuid())
  action                 String
  entityType             String
  entityId               String
  metadata               Json?
  requestId              String?
  previousHash           String?
  hash                   String
  actorUserId            String?
  organizationalUnitId   String?
  /// Paket 2.6 (§6.5): 1 = hash over metadata; 2 = hash over metadataDigest.
  hashVersion            Int                 @default(1)
  actionSchemaVersion    Int                 @default(1)
  /// SHA-256 of canonical metadata as written (v2 only).
  metadataDigest         String?
  /// Per-row algorithm, committed into the v3 canonical envelope.
  hashAlgorithm          String              @default("sha256")
  /// Independent append chain; global or one OU partition.
  chainPartition         String              @default("global")
  /// Metadata was redacted (anonymization); v1 rows become "sealed".
  redactedAt             DateTime?
  createdAt              DateTime            @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([organizationalUnitId])
  @@index([createdAt])
  @@index([chainPartition, createdAt, id])
}

/// Paket 5.4.2 (stavka 3): delivery state of the security-audit webhook.
/// A singleton row (`id = "default"`): the cursor of the last delivered (or
/// dropped) audit row, the start of the current failure streak and the
/// counters an operator needs to see that the export is healthy.
model SecurityAuditWebhookState {
  id              String   @id @default("default")
  cursorCreatedAt DateTime?
  cursorId        String?
  /// First failed attempt of the current streak; cleared on success or drop.
  pendingSince    DateTime?
  lastSuccessAt   DateTime?
  /// Short machine code of the last failure (e.g. HTTP_500, TIMEOUT); never a body.
  lastErrorCode   String?
  sentTotal       Int      @default(0)
  failedTotal     Int      @default(0)
  droppedTotal    Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model IntegrationJob {
  id          String                @id @default(cuid())
  type        IntegrationJobType
  status      IntegrationJobStatus  @default(PENDING)
  payload     Json
  lastError   String?
  attempts    Int                   @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, nextRetryAt])
  @@index([status, createdAt, id])
  @@index([type])
}

model ConfigVersion {
  id              String              @id @default(cuid())
  version         Int                 @unique
  status          ConfigVersionStatus @default(DRAFT)
  snapshot        Json
  releaseNotes    String?
  createdByUserId String?
  activatedAt     DateTime?
  /// Paket 2.9 (K4): provenance of a version created by importing a config
  /// package (source environment and version, checksum, signature state,
  /// manual mappings). Null for locally captured versions.
  importMeta      Json?
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
}

model AppSetting {
  id          String       @id @default(cuid())
  key         String       @unique
  value       Json
  scope       SettingScope
  isSecret    Boolean      @default(false)
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/// Paket 2.3 (R12): one inbound e-mail seen in the support mailbox. The pair
/// (mailboxKey, providerMessageId) is processed at most once. No body is kept
/// here; the raw .eml lives in storage for `rawRetentionDays`.
model InboundEmail {
  id                String             @id @default(cuid())
  mailboxKey        String             @db.VarChar(200)
  providerMessageId String             @db.VarChar(500)
  messageIdHeader   String?            @db.VarChar(500)
  fromAddress       String?            @db.VarChar(320)
  subject           String             @db.VarChar(200)
  receivedAt        DateTime?
  status            InboundEmailStatus @default(PROCESSING)
  reason            String?            @db.VarChar(64)
  ticketId          String?
  ticketMessageId   String?
  createdTicketId   String?
  rawStorageKey     String?            @db.VarChar(300)
  attempts          Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([mailboxKey, providerMessageId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([fromAddress, createdAt])
}

/// Paket 2.3: connector health per mailbox (shown on the admin page).
model InboundMailboxState {
  mailboxKey       String    @id @db.VarChar(200)
  lastRunAt        DateTime?
  lastSuccessAt    DateTime?
  lastError        String?   @db.VarChar(500)
  lastErrorAt      DateTime?
  consecutiveFails Int       @default(0)
  alertedAt        DateTime?
  updatedAt        DateTime  @updatedAt
}

model IdempotencyRecord {
  id             String            @id @default(uuid())
  namespace      String            @db.VarChar(80)
  key            String            @db.VarChar(128)
  requestHash    String            @db.Char(64)
  status         IdempotencyStatus @default(PROCESSING)
  ownerToken     String            @db.Uuid
  leaseExpiresAt DateTime
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  expiresAt      DateTime

  @@unique([namespace, key])
  @@index([status, leaseExpiresAt])
  @@index([expiresAt])
}

model OutboxMessage {
  id             String       @id @default(uuid())
  topic          String       @db.VarChar(100)
  dedupeKey      String       @db.VarChar(160)
  payload        Json
  payloadHash    String       @db.Char(64)
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(10)
  nextAttemptAt  DateTime     @default(now())
  ownerToken     String?      @db.Uuid
  leaseExpiresAt DateTime?
  lastError      String?      @db.VarChar(1000)
  completedAt    DateTime?
  replayCount    Int          @default(0)
  lastReplayedAt DateTime?
  lastReplayedBy String?      @db.VarChar(128)
  lastReplayReason String?    @db.VarChar(500)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  expiresAt      DateTime

  @@unique([topic, dedupeKey])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([expiresAt])
}
