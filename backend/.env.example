# Local NestJS / Prisma / worker only. Copy to backend/.env (gitignored).
# Coolify catalog and compose: repo-root .env.example
#
# Required: DATABASE_URL, REDIS_HOST
# Optional: PORT (default 10001), CORS_ORIGIN CSV (unset => HTTP/Socket.IO origin false; never *),
#   UPLOAD_ROOT, REDIS_PORT (default 6379), REDIS_USERNAME, REDIS_PASSWORD,
#   REDIS_KEY_PREFIX (default servicedesk), QUEUE_PREFIX (default bull:servicedesk)

DEPLOYMENT_ENV=development
DATABASE_URL="postgresql://servicedesk_runtime:PASSWORD@HOST:5432/servicedesk?sslmode=verify-full"
# Release-only credential; never inject into API/worker containers.
MIGRATION_DATABASE_URL="postgresql://servicedesk_migrator:PASSWORD@HOST:5432/servicedesk?sslmode=verify-full"
PORT=10001

# pg pool (plan §1.4). DB_POOL_MAX: 40 uz PgBouncer (transaction mode) ili
# 2× CPU jezgara direktno. statement_timeout štiti konekcije od upita koji traju minutama.
DB_POOL_MAX=40
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
# Deployment admission budget: replicas × pools + migrator + reserve <= max_connections.
DB_MAX_CONNECTIONS=120
DB_CONNECTION_RESERVE=10
API_REPLICAS=2
WORKER_REPLICAS=1
WORKER_DB_POOL_MAX=10
MIGRATOR_CONNECTION_BUDGET=2
# Worker proces ima duže poslove (SLA sken, retencija) — postavi u worker servisu:
# DATABASE_POOL_ROLE=worker
# DB_POOL_MAX=10
UPLOAD_ROOT="./uploads"
CORS_ORIGIN=http://localhost:5173

# Redis / BullMQ — same keys as root .env.example; password = ops/redis-acl.line
REDIS_HOST=redis-core
REDIS_PORT=6379
# Production mora postaviti true + CA path/base64 + cert hostname. Lokalni plaintext je development-only.
REDIS_TLS=false
REDIS_CA_CERT_PATH=
REDIS_CA_CERT_BASE64=
REDIS_SERVERNAME=redis.internal
REDIS_USERNAME=servicedesk
REDIS_PASSWORD=change-me
REDIS_KEY_PREFIX=servicedesk
QUEUE_PREFIX=bull:servicedesk

# Query budget (plan §0.3 + §4.2): one log line per request with the number of
# statements it cost. DB_QUERY_BUDGET_WARN turns the warning on — keep it OFF in
# production (the counter is always cheap, the warning is for dev/staging/CI).
DB_QUERY_METRICS=true
DB_QUERY_BUDGET=3
DB_QUERY_BUDGET_WARN=false
# CI/staging override used by .github/workflows/perf-smoke.yml:
# DB_QUERY_BUDGET_WARN=true

# Install wizard unlock token (min 16 chars); required before installation.
INSTALL_TOKEN=local-install-token-change-me
# Paket 2.1: AES-256-GCM ključ za TOTP tajne — base64 od tačno 32 bajta
# (`openssl rand -base64 32`). Obavezan za MFA; čuvati u backupu tajni —
# gubitak ključa znači ponovno postavljanje MFA za sve (CLI reset-mfa); promjena ide po ops/runbook/rotacija-tajni.md.
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktbWZhLWtleS0zMi1ieXRlcy1sb25nISE=
# Rotacija (ops/runbook/rotacija-tajni.md): stari ključ dok traje `secrets.js reencrypt-mfa`; inače prazno.
MFA_ENCRYPTION_KEY_PREVIOUS=
# Development može fallbackati; production zahtijeva zaseban eksplicitni ključ.
INBOUND_EMAIL_TOKEN_SECRET=local-inbound-secret
INBOUND_EMAIL_TOKEN_SECRET_PREVIOUS=
# Development može fallbackati; production zahtijeva zaseban eksplicitni ključ.
PRIVACY_TOMBSTONE_KEY=local-tombstone-secret
PRIVACY_TOMBSTONE_KEY_PREVIOUS=
# Paket 2.6: export encryption master key (>=16 chars or base64:<pin>). Empty = derived from MFA_ENCRYPTION_KEY.
# Changing it makes READY exports unreadable (they expire within 7 days anyway).
PRIVACY_EXPORT_KEY=local-export-secret
# Paket 2.7: fallback alarm channel, used only when Postgres or Redis is down.
# smtp[s]://user:pass@host:port; recipients comma-separated. Empty = log only.
OPS_ALERT_SMTP_URL=
OPS_ALERT_EMAIL_TO=
OPS_ALERT_EMAIL_FROM=
OPS_ALERT_TEAMS_WEBHOOK_URL=
# Paket 2.7: Uptime Kuma push URL (the worker pings it after every completed health check, once a minute).
OPS_UPTIME_PUSH_URL=

# Paket 2.9 (K4): opcionalan HMAC ključ za potpis paketa konfiguracije
# (min 32 znaka, `openssl rand -hex 32`). Isti na stagingu i produkciji;
# bez njega izvoz je nepotpisan, a uvoz traži eksplicitnu potvrdu.
CONFIG_PACKAGE_SIGNING_KEY=local-config-signing-key-at-least-32-chars

# Paket 3.1: Teams connector simulator (min. 32 characters). Without it simulator mode is unavailable.
TEAMS_SIMULATOR_SECRET=
# Paket 3.1: public API origin; the Teams messaging endpoint is <API_PUBLIC_URL>/integrations/teams/messages
# (falls back to APP_PUBLIC_URL when the API is served from the same origin).
API_PUBLIC_URL=

# W3.4: remote/WORM audit anchor. When enabled, startup and /health/ready fail closed.
AUDIT_ANCHOR_ENABLED=false
AUDIT_ANCHOR_WORM_URL=
AUDIT_ANCHOR_HMAC_KEY=
AUDIT_ANCHOR_KEY_ID=
AUDIT_ANCHOR_INTERVAL_MS=60000
AUDIT_ANCHOR_MAX_LAG_MS=300000
