# Local NestJS / Prisma / worker only. Copy to backend/.env (gitignored).
# Coolify catalog and compose: repo-root .env.example
#
# Required: DATABASE_URL, REDIS_HOST
# Optional: PORT (default 10001), CORS_ORIGIN (unset => Socket.IO origin false),
#   UPLOAD_ROOT, REDIS_PORT (default 6379), REDIS_USERNAME, REDIS_PASSWORD,
#   REDIS_KEY_PREFIX (default ephelpdesk), QUEUE_PREFIX (default bull:ephelpdesk)

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ephelpdesk"
PORT=10001
UPLOAD_ROOT="./uploads"
CORS_ORIGIN=http://localhost:5173

# Redis / BullMQ — same key names as root .env.example (no REDIS_URL)
REDIS_HOST=redis-core
REDIS_PORT=6379
REDIS_USERNAME=ephelpdesk
REDIS_PASSWORD=change-me
REDIS_KEY_PREFIX=ephelpdesk
QUEUE_PREFIX=bull:ephelpdesk
