# Copy to e2e/.env for local runs. Never commit real secrets.
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:10001
E2E_SUPERADMIN_EMAIL=e2e.superadmin@example.com
E2E_SUPERADMIN_PASSWORD=ChangeMeE2eSuperAdmin1!
E2E_USER_EMAIL=e2e.user@example.com
E2E_USER_PASSWORD=Kamen-Opseg-2026-U1!
E2E_AGENT_EMAIL=e2e.agent@example.com
E2E_AGENT_PASSWORD=Kamen-Opseg-2026-A1!
E2E_SMTP_HOST=127.0.0.1
E2E_SMTP_PORT=25
# Test accounts use the reserved domain example.com (RFC 2606): no real mailbox, and the
# e-mail policy never delivers to it, so temporary passwords stay readable by the harness.
# The user and agent passwords must pass the local password policy: no part of the account's
# own e-mail address (user, agent) and no organisation or domain word (example) may appear in
# them, otherwise the harness cannot set them through change-password. The super admin
# password is created by the install wizard, which only checks length and blankness.
# Optional: only for clearing the test super admin's MFA before a run.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/servicedesk
