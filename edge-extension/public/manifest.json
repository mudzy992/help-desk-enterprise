{
  "manifest_version": 3,
  "name": "EP-HelpDesk",
  "version": "0.0.1",
  "description": "Redacted HelpDesk notifications for Microsoft Edge.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EP-HelpDesk",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png"
  },
  "permissions": ["notifications", "storage"],
  "host_permissions": [
    "http://localhost:10001/*",
    "http://127.0.0.1:10001/*",
    "https://*.ba101.top/*",
    "https://*.epbih.ba/*"
  ]
}
