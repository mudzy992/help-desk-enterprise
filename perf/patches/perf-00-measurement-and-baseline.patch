+  it('still executes the statement when the counter runs', async () => {
+    const pool = createInstrumentedPool('postgresql://localhost:5432/unused');
+
+    await expect(pool.query('select 1')).resolves.toEqual({
+      rows: [],
+      rowCount: 0,
+    });
+  });
+});
