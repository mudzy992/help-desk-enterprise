+        matchesInMemoryTicket(ticket, where),
+      );
+      for (const ticket of matched) {
+        tickets.set(ticket.id, { ...ticket, ...data, updatedAt: now() });
+      }
+      return { count: matched.length };
+    },
   };
 }
 
