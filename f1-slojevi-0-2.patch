diff -ruN a/backend/src/modules/tickets/assignment/resolve-claim-conflict.ts b/backend/src/modules/tickets/assignment/resolve-claim-conflict.ts
--- a/backend/src/modules/tickets/assignment/resolve-claim-conflict.ts	1970-01-01 00:00:00.000000000 +0000
